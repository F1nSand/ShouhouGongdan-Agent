{
  "name": "aftercare-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:live-backend": "playwright test --config playwright.live-backend.config.ts"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.19.1",
    "@vitejs/plugin-vue": "6.0.2",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "vue-tsc": "3.1.1"
  }
}
