POSTGRES_DB=aftercare
POSTGRES_USER=aftercare_migrator
POSTGRES_PASSWORD=__GENERATE_LOCAL_ENV__
DB_APP_USERNAME=aftercare_app
DB_APP_PASSWORD=__GENERATE_LOCAL_ENV__
# This must match POSTGRES_USER; the generator makes its password match POSTGRES_PASSWORD.
DB_MIGRATION_USERNAME=aftercare_migrator
DB_MIGRATION_PASSWORD=__GENERATE_LOCAL_ENV__
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8081
WEB_PORT=8080
EMBEDDING_DIMENSIONS=1024
# Keep mock for offline development; set to live only after configuring a key.
SPRING_PROFILES_ACTIVE=mock
EMBEDDING_MODEL=text-embedding-v3
# Required for the live DashScope profile (without the deepseek profile).
DASHSCOPE_API_KEY=
# DashScope API base URL; chat and embedding models share this endpoint.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# Select the live,deepseek Spring profiles to use these DeepSeek settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
# Used by the live,deepseek profile for embeddings only.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
MODEL_REQUEST_BUDGET_ENABLED=true
MODEL_REQUEST_BUDGET_MAX_ATTEMPTS=50
# Optional local Docker demo retrieval threshold; the general live profile keeps its own application default.
LOCAL_DEMO_KNOWLEDGE_MIN_SIMILARITY=0.35
JWT_SECRET=__GENERATE_LOCAL_ENV__
POLICY_STORAGE_DIR=/data/policies
DEMO_SEED_ENABLED=true
DEMO_CSR_PASSWORD=__GENERATE_LOCAL_ENV__
DEMO_SUPERVISOR_PASSWORD=__GENERATE_LOCAL_ENV__
DEMO_WAREHOUSE_PASSWORD=__GENERATE_LOCAL_ENV__
DEMO_ADMIN_PASSWORD=__GENERATE_LOCAL_ENV__
